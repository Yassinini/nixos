e,"stopAtConnect":false,"cwd":"^\"\\${workspaceFolder}\"","environment":[],"MIMode":"gdb","miDebuggerServerAddress":"gdbserverHostIp:port","sourceFileMap":{"/original/source/path":"^\"\\${workspaceFolder}\""},"setupCommands":[{"description":"Enable pretty-printing for gdb","text":"-enable-pretty-printing","ignoreFailures":true}]}},{"label":"C/C++ Debug: Remote Attach with gdbserver","description":"Attach to an already-running program on a remote gdbserver (using extended-remote mode)","body":{"name":"C/C++ Debug: Remote Attach with gdbserver","type":"cppdbg","request":"attach","program":"^\"enter program name, for example: \\${workspaceFolder}/a.out\"","MIMode":"gdb","miDebuggerPath":"/usr/bin/gdb","miDebuggerServerAddress":"gdbserverHostIp:port","useExtendedRemote":true,"processId":"^\"\\${command:pickRemoteProcess}\"","sourceFileMap":{"/original/source/path":"^\"\\${workspaceFolder}\""},"setupCommands":[{"description":"Enable pretty-printing for gdb","text":"-enable-pretty-printing","ignoreFailures":true}]}},{"label":"C/C++ Debug: Remote Launch via Pipe Program","description":"Launch a C/C++ program on a remote host via a pipe program (e.g. ssh, docker exec). The local machine does not need GDB; the MI debugger runs on the remote host","body":{"name":"C/C++ Debug: Remote Launch via Pipe Program","type":"cppdbg","request":"launch","program":"/path/to/debugee/on/remote","cwd":"/path/to/debugee/cwd","MIMode":"gdb","stopAtEntry":true,"stopAtConnect":false,"pipeTransport":{"pipeCwd":"/usr/bin","pipeProgram":"ssh","pipeArgs":["-p","22","user@remoteHostIp"],"debuggerPath":"/usr/bin/gdb","quoteArgs":true},"sourceFileMap":{"/original/source/path":"^\"\\${workspaceFolder}\""},"setupCommands":[{"description":"Enable pretty-printing for gdb","text":"-enable-pretty-printing","ignoreFailures":true}]}},{"label":"C/C++ Debug: Remote Attach via Pipe Program","description":"Attach to a running C/C++ process on a remote host via a pipe program (e.g. ssh, docker exec). The local machine does not need GDB; the MI debugger runs on the remote host","body":{"name":"C/C++ Debug: Remote Attach via Pipe Program","type":"cppdbg","request":"attach","program":"/path/to/debugee/on/remote","processId":"^\"\\${command:pickRemoteProcess}\"","MIMode":"gdb","pipeTransport":{"pipeCwd":"/usr/bin","pipeProgram":"ssh","pipeArgs":["-p","22","user@remoteHostIp"],"debuggerPath":"/usr/bin/gdb","quoteArgs":true},"sourceFileMap":{"/original/source/path":"^\"\\${workspaceFolder}\""},"setupCommands":[{"description":"Enable pretty-printing for gdb","text":"-enable-pretty-printing","ignoreFailures":true}]}},{"label":"C/C++ Debug: Core Dump Analysis","description":"Analyze a core dump file offline using GDB (requires specifying the original executable and core dump path)","body":{"name":"C/C++ Debug: Core Dump Analysis","type":"cppdbg","request":"launch","program":"/path/to/crashed/executable","cwd":"^\"\\${workspaceFolder}\"","coreDumpPath":"/path/to/coredump","MIMode":"gdb","miDebuggerPath":"/usr/bin/gdb"}}]}],"breakpoints":[{"language":"ada"},{"language":"c"},{"language":"cpp"},{"language":"cuda-cpp"},{"language":"cuda"},{"language":"rust"}],"configuration":{"title":"C/C++ Debug","properties":{"cppdebug.autoLoadPrettyPrinters":{"type":"boolean","default":true,"description":"Automatically load GDB pretty printers when debugging with GDB. This enables better visualization of complex C++ types like Qt containers and STL types."},"cppdebug.enablePrettyPrinting":{"type":"boolean","default":true,"description":"Enable GDB pretty printing for the debugging session."}}},"commands":[{"command":"cppdebug.attachToProcess","title":"Attach to Process...","category":"C/C++ Debug","icon":"$(plug)"},{"command":"cppdebug.attachToProcessWithConfiguration","title":"Attach to Process with Configuration...","category":"C/C++ Debug","icon":"$(settings-gear)"}],"menus":{"commandPalette":[{"command":"cppdebug.attachToProcess","group":"1_attach@0"},{"command":"cppdebug.attachToProcessWithConfigura