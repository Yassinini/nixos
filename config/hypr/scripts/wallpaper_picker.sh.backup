#!/usr/bin/env bash

DIR="$HOME/Pictures/Wallpapers"
CACHE_DIR="$HOME/.cache/wallpaper_thumbs"
ROFI="/etc/profiles/per-user/suupatruupa/bin/rofi"
AWWW="/run/current-system/sw/bin/awww"
MATUGEN="/etc/profiles/per-user/suupatruupa/bin/matugen"
NOTIFY="/run/current-system/sw/bin/notify-send"

mkdir -p "$CACHE_DIR"

# 1. Generate thumbnail cache
for img in "$DIR"/*; do
    [ -f "$img" ] || continue
    filename=$(basename "$img")
    thumb="$CACHE_DIR/$filename"

    if [ ! -f "$thumb" ]; then
        if command -v magick &>/dev/null; then
            magick "$img" -thumbnail 480x270 "$thumb" &
        elif command -v ffmpeg &>/dev/null; then
            ffmpeg -loglevel quiet -i "$img" -vf "scale=480:-1" "$thumb" -y &
        else
            cp "$img" "$thumb" &
        fi
    fi
done
wait

# 2. Build menu stream
ROFI_INPUT=""
for img in "$DIR"/*; do
    [ -f "$img" ] || continue
    filename=$(basename "$img")
    thumb="$CACHE_DIR/$filename"
    ROFI_INPUT+="${filename}\x00icon\x1f${thumb}\n"
done

# 3. Launch Coverflow Rofi Picker
SELECTION=$(printf "%b" "$ROFI_INPUT" | $ROFI -dmenu \
    -p "Select Wallpaper" \
    -show-icons \
    -theme-str '
        @import "~/.config/rofi/colors.rasi"

        * {
            background-color: transparent;
            text-color: @foreground;
        }

        window {
            anchor: center;
            location: center;
            width: 85%;
            height: 400px;
            border-radius: 16px;
            background-color: @background;
            border: 2px solid;
            border-color: @accent;
            padding: 20px;
        }

        mainbox {
            children: [ listview ];
        }

        listview {
            layout: horizontal;
            lines: 7;
            columns: 1;
            spacing: 12px;
            cycle: true;
            dynamic: true;
        }

        element {
            orientation: vertical;
            padding: 10px;
            border-radius: 12px;
            width: 140px;
            border: 1px solid;
            border-color: transparent;
        }

        element selected {
            background-color: @background-alt;
            border: 2px solid;
            border-color: @accent;
            width: 320px;
        }

        element-icon {
            size: 260px;
            horizontal-align: 0.5;
            vertical-align: 0.5;
            expand: true;
        }

        element-text {
            horizontal-align: 0.5;
            vertical-align: 0.5;
            expand: false;
            font: "JetBrainsMono Nerd Font 10";
        }
    ')

if [ -n "$SELECTION" ]; then
    IMAGE=$(realpath "$DIR/$SELECTION")

    if [ -f "$IMAGE" ]; then
        pkill -9 mpvpaper 2>/dev/null

        # Apply wallpaper
        $AWWW img -o eDP-1 "$IMAGE"

        # Extract colors via Matugen
        if [ -f "$MATUGEN" ]; then
            $MATUGEN image "$IMAGE" --type scheme-tonal-spot
        elif command -v matugen &>/dev/null; then
            matugen image "$IMAGE" --type scheme-tonal-spot
        fi

        # Reload Waybar to apply new colors instantly
        pkill -USR2 waybar 2>/dev/null

        $NOTIFY "Wallpaper" "Applied & Matugen Synced: $SELECTION"
    fi
fi
