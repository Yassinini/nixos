{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos_small",
    "position": "top",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "┌─── System Information ───┐"
    },
    {
      "type": "os",
      "key": "│  distro "
    },
    {
      "type": "shell",
      "key": "│  shell  "
    },
    {
      "type": "terminal",
      "key": "│  term   "
    },
    {
      "type": "terminalfont",
      "key": "│ 󰛖 font   "
    },
    {
      "type": "cpu",
      "key": "│  cpu    "
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 gpu    "
    },
    {
      "type": "memory",
      "key": "│ 󰍛 memory "
    },
    {
      "type": "disk",
      "key": "│ 󰋊 disk   "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────┘"
    },
    "break",
    "colors"
  ]
}
