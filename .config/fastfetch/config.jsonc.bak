{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "  ____  __  __  __  __  _____      __      \n /',__\\/\\ \\/\\ \\/\\ \\/\\ \\/\\ '__`\\  /'__`\\    \n/\\__, `\\ \\ \\_\\ \\ \\ \\_\\ \\ \\ \\L\\ \\/\\ \\L\\.\\_  \n\\/\\____/\\ \\____/\\ \\____/\\ \\ ,__/\\ \\__/.\\_\\ \n \\/___/  \\/___/  \\/___/  \\ \\ \\/  \\/__/\\/_/ \n                          \\ \\_\\            \n                           \\/_/            ",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌─── System Information ───┐"
    },
    {
      "type": "os",
      "key": "│  distro "
    },
    {
      "type": "uptime",
      "key": "│ 󱎫 uptime "
    },
    {
      "type": "shell",
      "key": "│  shell  "
    },
    {
      "type": "terminal",
      "key": "│  term   "
    },
    {
      "type": "cpu",
      "key": "│  cpu    "
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 gpu    "
    },
    {
      "type": "memory",
      "key": "│ 󰍛 memory "
    },
    {
      "type": "disk",
      "key": "│ 󰋊 disk   "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────┘"
    },
    "break",
    "colors"
  ]
}
